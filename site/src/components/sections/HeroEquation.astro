---
import EquationGlyph from "../svg/EquationGlyph.astro";
import { equation } from "../../content/brand";
---
<section class="relative min-h-[100dvh] flex items-center" aria-labelledby="hero-heading">
  <div class="container-page py-24 grid gap-16 w-full">
    <div class="space-y-10 max-w-5xl">
      <p class="eyebrow reveal">SIX WEEKS</p>
      <h1 id="hero-heading" class="text-display-1 text-platinum reveal">
        Most AI strategies are<br class="hidden md:block" /> productivity theater.
      </h1>
      <p class="text-body-lg max-w-2xl text-mercury reveal">
        Yours has six weeks to be different.
      </p>
      <div class="reveal pt-4 max-w-2xl opacity-70">
        <EquationGlyph class="w-full" />
      </div>
      <p class="eyebrow reveal text-mist">{equation.caption}</p>
      <div class="reveal pt-6">
        <a href="/engage#form" class="btn-signal">
          Request a conversation →
        </a>
      </div>
    </div>
  </div>
</section>
